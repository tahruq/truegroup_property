{
  "doctype": "Workflow",
  "workflow_name": "Truegroup Property Onboarding",
  "document_type": "Utility Property",
  "is_active": 1,
  "workflow_state_field": "workflow_state",
  "send_email_alert": 0,
  "states": [
    {
      "state": "Draft",
      "doc_status": "0",
      "allow_edit": "All"
    },
    {
      "state": "Pending Approval",
      "doc_status": "0",
      "allow_edit": "Property User"
    },
    {
      "state": "Approved",
      "doc_status": "1",
      "allow_edit": "Property Manager"
    },
    {
      "state": "Rejected",
      "doc_status": "1",
      "allow_edit": "Property Manager"
    }
  ],
  "transitions": [
    {
      "state": "Draft",
      "action": "Review",
      "next_state": "Pending Approval",
      "allowed": "All",
      "allow_self_approval": 1,
      "condition": "doc.property_name and doc.custom_property_type and doc.custom_cost_center and doc.location and doc.territory"
    },
    {
      "state": "Pending Approval",
      "action": "Approve",
      "next_state": "Approved",
      "allowed": "Property Manager",
      "allow_self_approval": 1
    },
    {
      "state": "Pending Approval",
      "action": "Reject",
      "next_state": "Draft",
      "allowed": "Property Manager",
      "allow_self_approval": 1,
      "condition": "doc.custom_rejection_reason"
    }
  ]
}
